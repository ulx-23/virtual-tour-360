# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local migration backups (may contain database rows and credentials)
/.migration-backups/

# Private uploads and generated exports / isolated offline QA output
/public/uploads/
/public/exports/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
